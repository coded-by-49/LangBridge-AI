# ---------------------------------------------------------------
# Repo overhaul (Igbo 1.0): keep secrets, envs, IDE files, weights
# and large data out of git.
# ---------------------------------------------------------------

# Secrets: never commit
secrets.env
**/secrets.env
*.env
.env*

# Virtual environments (root and nested)
.venv/
**/.venv/
venv/

# IDE settings (root and nested)
.idea/
**/.idea/
.vscode/

# Python caches
__pycache__/
*.py[cod]

